# SwiftPM
.build-mechanisms/
.build/
.swiftpm/
Package.resolved.bak

# Benchmark baselines. Upstream calls the stored format unstable, and a
# baseline is a statement about one machine — numbers meant to outlive a
# session belong in docs/swift/design/perf.md with their environment beside
# them. `swift/Benchmarks/Package.resolved` is deliberately NOT ignored.
.benchmarkBaselines/
Thresholds/
!swift/Benchmarks/Thresholds/
!swift/Benchmarks/Thresholds/*.p90.json

# CogLint artifact-bundle products. The source, exact pins, and reproducible
# build/selection pipeline are committed; release binaries are not.
swift/Lint/Artifacts/CogLintBinary.artifactbundle/
swift/Lint/Artifacts/CogLintBinary.artifactbundle.zip
swift/Lint/Artifacts/CogLintBinary.artifactbundle.zip.checksum

