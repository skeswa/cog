# SwiftPM. `.build-*` covers the alternate scratch paths the probes and test
# wrappers use, such as the `M9-01` probe's `--scratch-path .build-arena`.
# The probe's interposer is built by the clang line in its method document
# rather than by SwiftPM, so its products are ignored by name.
swift/Benchmarks/probes/**/libcogprof.dylib
swift/Benchmarks/probes/**/libcogprof.dylib.dSYM/
.build-mechanisms/
.build/
.build-*/
.swiftpm/
Package.resolved.bak

# Benchmark baselines. Upstream calls the stored format unstable, and a
# baseline is a statement about one machine — numbers meant to outlive a
# session belong in docs/swift/design/perf.md with their environment beside
# them. `swift/Benchmarks/Package.resolved` is deliberately NOT ignored.
.benchmarkBaselines/
Thresholds/
!swift/Benchmarks/Thresholds/
!swift/Benchmarks/Thresholds/*.p90.json

# CogLint artifact-bundle products. The source, exact pins, and reproducible
# build/selection pipeline are committed; release binaries are not.
swift/Lint/Artifacts/CogLintBinary.artifactbundle/
swift/Lint/Artifacts/CogLintBinary.artifactbundle.zip
swift/Lint/Artifacts/CogLintBinary.artifactbundle.zip.checksum
swift/Lint/Artifacts/CogLintBinary.artifactbundle.zip.provenance.json

# The VitePress documentation site. `node_modules/` is the repository's only
# dependency tree and belongs to the docs site alone — the Swift package still
# resolves with nothing. The assembled site lands under `.build/`, already
# ignored above.
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# macOS
.DS_Store
.build-mechanisms/
